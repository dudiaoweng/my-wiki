certs/*.p12
certs/*.crt
certs/*.csr
certs/*.jks
certs/client*.conf
certs/tmp_*.cnf
certs/verify_output.txt

# ===== 运行时数据 =====
backend/uploads/
*.db
*.sqlite3

# ===== Docker 数据目录（本机绑定挂载） =====
data/
uploads/

# ===== Node / 前端 =====
node_modules/

