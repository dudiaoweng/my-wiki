# 复制为 .env 后填入实际值（.env 已被 gitignore，不会提交）
# Docker 部署与本地开发共用这一份：
#   Docker：本文件挂载为容器内 /app/.env，后端启动时读取；改后 docker compose restart 生效
#   本地开发：config.py 显式加载本文件（cwd 在 backend/ 下同样生效）
# 路径类变量（DATABASE_URL / UPLOAD_DIR / SSL_*）不写在这里：
#   容器内由 Dockerfile ENV 提供默认，本地由代码默认值兜底

# ─── LLM 文本模型（标题生成、实体提取、纯文本问答）───
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=GLM-5.2

# ─── 视觉模型（图片描述、视频分析）───
VISION_API_KEY=your-api-key-here
VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=GLM-5V-Turbo

# ─── 语音识别模型（音频转文字）───
ASR_API_KEY=your-api-key-here
ASR_API_BASE=https://open.bigmodel.cn/api/paas/v4
ASR_MODEL=GLM-ASR-2512

# ─── 嵌入模型（语义搜索）───
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# ─── 问答 ───
QA_TEMPERATURE=0.2

# ─── 自动解析（仅控制 LLM 类解析：媒体描述、标签/实体提取；文档文本提取始终自动）───
AUTO_PARSE=0

# ─── mTLS 白名单（留空 = allow-all；非空 = 逗号分隔 subject DN）───
# 例：/C=CN/ST=32/L=00/O=11/OU=00/CN=姓名 身份证号
ALLOWED_CERT_SUBJECTS=
