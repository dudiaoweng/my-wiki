[ ca ]
default_ca = CA_default

[ CA_default ]
dir = .
database = ./index.txt
new_certs_dir = .
certificate = ./ca.crt
private_key = ./ca.key
serial = ./ca.srl
default_md = sha256
default_days = 3650
default_crl_days = 3650
policy = policy_any
unique_subject = no
x509_extensions = client_ext

[ policy_any ]
commonName = supplied

[ client_ext ]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = clientAuth
