# Git
.git
.gitignore

# 镜像导出产物（1GB+ tar 不进构建上下文）
dist/
*.tar

# 环境变量（含 API Key，不进构建上下文）
.env

# Python
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/*.pyc
backend/knowledge_base.db
backend/.output.log

# Node
frontend/node_modules
frontend/dist

# 数据目录（本机绑定挂载，v2.3 起统一：数据库 + 上传 + Qdrant + Neo4j）
data/

# 证书产物（vite.config.ts 只需 .crt/.key，p12/jks/csr 等分发文件无需进构建）
certs/*.p12
certs/*.jks
certs/*.csr
certs/*.srl
certs/debug.log
certs/*.conf

# IDE / OS / 工具配置
.vscode
.idea
.claude
*.log
Thumbs.db
.DS_Store
